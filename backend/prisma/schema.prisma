datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String        @id @default(uuid())
  email        String        @unique
  passwordHash String
  secrets      VaultSecret[]
  createdAt    DateTime      @default(now())
}

model VaultSecret {
  id             String   @id @default(uuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title          String // e.g., "Stripe Production API Key"
  encryptedValue String // AES-256-GCM format: iv:authTag:ciphertext
  maskedPreview  String // Safe for UI display: "****9a2f"
  createdAt      DateTime @default(now())

  @@index([userId])
}
